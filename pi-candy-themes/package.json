{
  "name": "pi-candy-themes",
  "version": "1.0.0",
  "description": "Selenized themes for Pi, based on Jan Warchoł's Selenized color palette.",
  "type": "module",
  "license": "MIT",
  "author": "CandyMuj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CandyMuj/pi-candy-extensions.git",
    "directory": "pi-candy-themes"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-theme",
    "selenized",
    "tui",
    "terminal",
    "theme"
  ],
  "files": [
    "themes",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build:themes": "node scripts/generate-themes.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "themes": [
      "./themes"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
