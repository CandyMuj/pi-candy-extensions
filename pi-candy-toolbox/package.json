{
  "name": "pi-candy-toolbox",
  "version": "1.0.0",
  "type": "module",
  "description": "pi 的小工具聚合箱 — 收纳零散小功能，每个工具独立开关、独立配置",
  "keywords": [
    "pi-package",
    "pi-extension",
    "toolbox",
    "utility"
  ],
  "author": "CandyMuj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CandyMuj/pi-candy-extensions.git",
    "directory": "pi-candy-toolbox"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "docs",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
